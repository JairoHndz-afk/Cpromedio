{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/compartir/:slug",
      "destination": "/api/compartir/:slug"
    },
    {
      "source": "/articulo/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|meta-externalagent|WhatsApp|whatsapp|Twitterbot|twitterbot|TelegramBot|telegrambot|Slackbot|Discordbot|LinkedInBot|linkedinbot|SkypeUriPreview|bot|crawler|spider).*"
        }
      ],
      "destination": "/api/articulo/:slug"
    },
    {
      "source": "/api/:path*",
      "destination": "https://colombiano-promedio-backend.onrender.com/api/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "https://colombiano-promedio-backend.onrender.com/api/public/seo/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://colombiano-promedio-backend.onrender.com/api/public/seo/sitemap.xml"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
