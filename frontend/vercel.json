{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "colombianopromedio.co"
        }
      ],
      "destination": "https://www.colombianopromedio.co/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/compartir/:slug",
      "destination": "/api/compartir/[slug]"
    },
    {
      "source": "/api/articulo/:slug",
      "destination": "/api/articulo/[slug]"
    },
    {
      "source": "/api/compartir/:slug",
      "destination": "/api/compartir/[slug]"
    },
    {
      "source": "/api/:path((?!articulo/|compartir/).*)",
      "destination": "https://colombiano-promedio-backend.onrender.com/api/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "https://colombiano-promedio-backend.onrender.com/api/public/seo/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://colombiano-promedio-backend.onrender.com/api/public/seo/sitemap.xml"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
