{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://colombiano-promedio-backend.onrender.com/api/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "https://colombiano-promedio-backend.onrender.com/api/public/seo/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://colombiano-promedio-backend.onrender.com/api/public/seo/sitemap.xml"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
