NODE_ENV=production
PORT=4000

# Base de datos
MONGODB_URI=mongodb://usuario:clave@host:27017/periodico?authSource=admin

# URLs publicas reales
PUBLIC_SITE_URL=https://tudominio.com
PUBLIC_SERVER_URL=https://tudominio.com

# Origenes y hosts permitidos
FRONTEND_ORIGINS=https://tudominio.com
ALLOWED_HOSTS=tudominio.com

# Sesion y autenticacion
JWT_SECRET=REEMPLAZA_ESTO_CON_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=8h
COOKIE_NAME=periodico_session
COOKIE_MAX_AGE_MS=28800000
TRUST_PROXY=true

# Flujo editorial
BOOTSTRAP_ON_START=false
NEWSLETTER_REQUIRE_CONFIRM=true

# Correo transaccional con Resend
RESEND_API_KEY=REEMPLAZA_ESTO_CON_TU_API_KEY_DE_RESEND
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_REPLY_TO=redaccion@tudominio.com

# Correo transaccional alternativo por SMTP
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@tudominio.com
SMTP_PASS=REEMPLAZA_ESTO_CON_LA_CLAVE_SMTP
SMTP_FROM_NAME=Colombiano Promedio
SMTP_FROM_EMAIL=no-reply@tudominio.com
SMTP_REPLY_TO=redaccion@tudominio.com

# Usuarios iniciales
ADMIN_NAME=Administrador General
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=REEMPLAZA_ESTO_CON_UNA_CLAVE_SEGURA
JOURNALIST_NAME=Periodista Base
JOURNALIST_EMAIL=periodista@tudominio.com
JOURNALIST_PASSWORD=REEMPLAZA_ESTO_CON_OTRA_CLAVE_SEGURA
